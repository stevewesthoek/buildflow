{
  "name": "@workbench/mcp",
  "version": "1.3.12-beta",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.20.2 <21"
  },
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./registration": {
      "types": "./dist/registration-manifest.d.ts",
