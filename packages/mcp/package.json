    "./device-registry": {
      "types": "./dist/device-registry.d.ts",
      "default": "./dist/device-registry.js"
    },
    "./distributed-dispatch": {
      "types": "./dist/distributed-dispatch.d.ts",
      "default": "./dist/distributed-dispatch.js"
    },
    "./worker-fairness": {
      "types": "./dist/worker-fairness.d.ts",
      "default": "./dist/worker-fairness.js"
    },
    "./cross-device-approval": {
      "types": "./dist/cross-device-approval.d.ts",
      "default": "./dist/cross-device-approval.js"
    },
    "./encrypted-sync": {
      "types": "./dist/encrypted-sync.d.ts",
      "default": "./dist/encrypted-sync.js"
    },
    "./managed-team-policy": {
      "types": "./dist/managed-team-policy.d.ts",
      "default": "./dist/managed-team-policy.js"
    }
