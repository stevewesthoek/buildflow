      "types": "./dist/provider-benchmark.d.ts",
      "default": "./dist/provider-benchmark.js"
    },
    "./ide-adapters": {
      "types": "./dist/ide-adapters.d.ts",
      "default": "./dist/ide-adapters.js"
    },
    "./workspace-discovery": {
      "types": "./dist/workspace-discovery.d.ts",
      "default": "./dist/workspace-discovery.js"
    },
    "./workspace-grants": {
      "types": "./dist/workspace-grants.d.ts",
      "default": "./dist/workspace-grants.js"
    },
    "./artifact-bridge": {
      "types": "./dist/artifact-bridge.d.ts",
      "default": "./dist/artifact-bridge.js"
    },
    "./executor-broker": {
      "types": "./dist/executor-broker.d.ts",
      "default": "./dist/executor-broker.js"
    },
    "./automatic-delegation": {
      "types": "./dist/automatic-delegation.d.ts",
      "default": "./dist/automatic-delegation.js"
